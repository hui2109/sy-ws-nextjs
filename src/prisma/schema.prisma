// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleStatus {
  PUBLISHED
  PENDING_REVIEW
  DRAFT
  NODATA
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum LeaveApplyStatus {
  APPROVED
  REJECTED
  PENDING_REVIEW
  DRAFT
}

enum LeaveApplyType {
  SHIFT_SCHEDULE
  ASKOFF
  CHANGE_SCHEDULE
}

model Person {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  avatar       String
  name         String   @unique
  weight       Float    @default(0.5)
  hireDate     DateTime @db.Date
  workNumber   String   @unique
  phoneNumber  String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(-1)
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  scheduleAssignments       ScheduleAssignment[]
  vacationRules             VacationRule[]
  leaveAppointments         LeaveAppointment[]
  expectedSchedules         ExpectedSchedule[]
  leaveAppliesAsApplyUserId LeaveApply[]         @relation("applyUser")
  leaveAppliesAsTargetStaff LeaveApply[]         @relation("targetStaff")
}

model BanType {
  id          Int      @id @default(autoincrement())
  banCode     String   @unique
  banName     String   @unique
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  color       String   @default("red")

  workSchedules     WorkSchedule[]
  vacationRules     VacationRule[]
  leaveAppointments LeaveAppointment[]
  expectedSchedules ExpectedSchedule[]
  // askOffApplies            AskOffApply[]
  // changeScheduleApplyItems ChangeScheduleApplyItem[]
}

model WorkSchedule {
  id        Int            @id @default(autoincrement())
  workDate  DateTime       @db.Date
  status    ScheduleStatus @default(DRAFT)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  banTypeId Int

  scheduleAssignments ScheduleAssignment[]

  banType BanType @relation(fields: [banTypeId], references: [id])

  @@unique([workDate, banTypeId])
}

model VacationRule {
  id                Int      @id @default(autoincrement())
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  availableHalfDays Int
  isHidden          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  personId          Int
  banTypeId         Int

  person  Person  @relation(fields: [personId], references: [id])
  banType BanType @relation(fields: [banTypeId], references: [id])

  @@unique([startDate, endDate, personId, banTypeId])
}

model LeaveAppointment {
  id              Int      @id @default(autoincrement())
  sequenceNumber  Int
  appointmentDate DateTime @db.Date
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  personId        Int
  banTypeId       Int

  person  Person  @relation(fields: [personId], references: [id])
  banType BanType @relation(fields: [banTypeId], references: [id])

  @@unique([appointmentDate, personId])
}

model ExpectedSchedule {
  id              Int      @id @default(autoincrement())
  sequenceNumber  Int
  appointmentDate DateTime @db.Date
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  personId        Int
  banTypeId       Int

  person  Person  @relation(fields: [personId], references: [id])
  banType BanType @relation(fields: [banTypeId], references: [id])

  @@unique([appointmentDate, personId])
}

model LeaveApply {
  id              Int              @id @default(autoincrement())
  leaveApplyType  LeaveApplyType
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  reason          String
  status          LeaveApplyStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  applyUserId     Int
  targetStaffId   Int?
  assignmentsJson Json

  applyUser   Person  @relation("applyUser", fields: [applyUserId], references: [id])
  targetStaff Person? @relation("targetStaff", fields: [targetStaffId], references: [id])
}

